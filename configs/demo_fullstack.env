# Local full-stack smoke test — production-like (classic Marie, no Next.js).
# Use: set DEMO_CONFIG=fullstack before starting demos.server

MINI_MARIE_DATA_DIR=D:/mini_marie_data/data

DEMO_LLM_MODEL=gpt-4o
# Full SQLite cache on every online/offline workflow step
DEMO_AUTO_OFFLINE=true
DEMO_FORCE_REFRESH=false

# Dual-source Marie QA: web search + KG (see mini_marie/web_search/README.md)
MARIE_WEB_SEARCH=1
WEB_SEARCH_BACKEND=openrouter
WEB_SEARCH_MODEL=openai/gpt-4o:online
WEB_SEARCH_OPENROUTER_ONLINE=0
MARIE_EXTENDED_ANSWERS=1
MARIE_HYBRID_MAX_TOKENS=12000
MARIE_HYBRID_TABLE_ROWS=40

MARIE_FRONTEND_PROXY=0
DEMO_HOST=127.0.0.1
DEMO_PORT=8080
