# TWA hybrid RAG (Bundestag Q&A) — local dev
# Clone/setup: python -m demos.setup_rag_frontend --install
# Run UI:      python -m demos.run_rag_frontend

# Serve UI without Blazegraph (sample questions only; /query/ returns a hint)
RAG_UI_ONLY=true

# FastAPI bind
RAG_HOST=127.0.0.1
RAG_PORT=8000

# Config file inside vendor/RAG/ (generated from config-template.yaml)
# RAG_CONFIG=config-hybrid.yaml

# Full backend: TWA stack Blazegraph at localhost:3838, then:
# RAG_UI_ONLY=false
