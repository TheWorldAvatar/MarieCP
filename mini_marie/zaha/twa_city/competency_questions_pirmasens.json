{
  "_pattern": {
    "numeric_threshold": [
      "1. Atomic extract: full IRI + numeric column (e.g. list_buildings_with_height, list_dabgeo_heat_supply)",
      "2. filter_rows on the row pool with $min_height_m / $min_heat_kwh_per_m2 (mini_marie.row_filters)"
    ],
    "ranking": [
      "1. Atomic extract: full IRI + sortable numeric column",
      "2. Optional filter_rows",
      "3. top_n_by_field (not SPARQL ORDER BY + threshold)"
    ],
    "corpus_stats": [
      "Aggregate min/max/avg over full graph via dedicated stats tools (get_height_stats, get_heat_supply_stats)"
    ]
  },
